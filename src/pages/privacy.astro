---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.privacy;
const seo = resolvePageSeo('/privacy/');
const sections = [
  ...content.sections,
  {
    heading: 'What this site does not collect',
    paragraphs: [
      'This informational site does not provide account registration, public posting, or payment processing. It does not ask visitors to submit license keys, passwords, or order details. If a browser stores a theme preference, that preference remains on the device unless the browser is cleared.',
      'Following an external purchase link takes you to a separate service with its own privacy notice, cookie practices, and payment process. Review that service’s information before entering personal or payment details, and use its verified support channel for order questions.',
    ],
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: content.title,
      description: content.description,
      url: '/privacy/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Privacy Policy', path: '/privacy/' },
    ]),
  ]}
>
  <LegalPage
    title={content.title}
    description={content.description}
    breadcrumbLabel="Privacy Policy"
    sections={sections}
  />
</BaseLayout>
