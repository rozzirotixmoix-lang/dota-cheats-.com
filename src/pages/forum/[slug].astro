---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { forumPosts, getForumPost } from '../../data/forum';
import { pageTitle } from '../../config/seo';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';

export function getStaticPaths() {
  return forumPosts.map((post) => ({ params: { slug: post.slug } }));
}

const post = getForumPost(Astro.params.slug!);
if (!post) return Astro.redirect('/forum/');
const path = `/forum/${post.slug}/`;
const metaDescriptions: Record<string, string> = {
  'hero-combo': 'Explore what to confirm about hero support, ability coverage, item behavior, and manual control before comparing automation options.',
  'ward-controls': 'Review ward display questions, scaling, marker controls, and readability considerations before comparing an overlay configuration.',
};
const description = metaDescriptions[post.slug] ?? post.excerpt;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Forum', path: '/forum/' }, { name: post.category, path: '/forum/' }, { name: post.title, path }];
const relatedPosts = [
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category === post.category),
  ...forumPosts.filter((item) => item.slug !== post.slug && item.category !== post.category),
].slice(0, 3);
---

<BaseLayout title={pageTitle(post.title)} description={description} jsonLd={[
  webPageSchema({ name: post.title, description, url: path }),
  breadcrumbSchema(breadcrumbs),
]}>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="forum-layout forum-layout--detail">
        <main class="forum-main">
          <article class="forum-detail-card" data-forum-vote data-post-slug={post.slug} data-upvotes={post.upvotes}>
            <div class="forum-vote forum-vote--detail" aria-label="Discussion voting">
              <button class="forum-vote__up" type="button" disabled aria-label="Voting is unavailable in this preview"><Icon name="chevronDown" size={17} /></button><strong data-vote-count>{post.upvotes}</strong><button type="button" disabled aria-label="Downvoting is unavailable"><Icon name="chevronDown" size={17} /></button>
            </div>
            <div class="forum-detail-content">
              <div class="forum-post-meta"><span class={`forum-community-avatar tone-${post.categoryTone}`}><Icon name="users" size={15} /></span><a href="/forum/" class="forum-community-name">d/{post.category.toLowerCase().replaceAll(' ', '')}</a><span>·</span><span><Icon name="userRound" size={13} /> {post.author}</span><span>{post.age}</span></div>
              <h1>{post.title}</h1>
              {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
              <div class="forum-detail-copy">{post.body.map((paragraph) => <p>{paragraph}</p>)}</div>
              {post.suggestedLinks?.length ? <section class="forum-source forum-source--detail" aria-label="Related references"><span>Related references: </span>{post.suggestedLinks.map((link, index) => <><a href={link.href}>{link.label}</a>{index < post.suggestedLinks!.length - 1 && <span> · </span>}</>)}</section> : null}
              {post.sourceTitle && <p class="forum-source forum-source--detail">Related: <a href={post.sourcePath}>{post.sourceTitle}</a></p>}
              <div class="forum-post-actions forum-post-actions--detail"><a href="#comments"><Icon name="messageCircle" size={16} /> {post.commentsCount} example replies</a><a href={post.sourcePath}><Icon name="navBlog" size={15} /> Compare related features</a></div>
              <div class="forum-login-prompt"><span class="forum-user-dot">i</span><span>Illustrative discussion</span><span>Fictional examples; posting and voting are unavailable</span></div>
              <section class="forum-comments" id="comments" aria-labelledby="comments-title">
                <div class="forum-comments__heading"><h2 id="comments-title">Replies <span>{post.commentsCount}</span></h2><span>Illustrative experiences</span></div>
                {post.comments.map((comment) => (
                  <article class="forum-comment">
                    <div class="forum-comment__rail"><span class="forum-comment__avatar"><Icon name="userRound" size={14} /></span><span class="forum-comment__line"></span></div>
                    <div class="forum-comment__body"><div class="forum-comment__meta"><b>{comment.author}</b><span>·</span><span>{comment.age}</span></div><p>{comment.body}</p>
                    {comment.replies?.map((reply) => <div class="forum-comment forum-comment--reply"><div class="forum-comment__rail"><span class="forum-comment__avatar">{reply.author.slice(0, 1).toUpperCase()}</span></div><div class="forum-comment__body"><div class="forum-comment__meta"><b>u/{reply.author}</b><span>·</span><span>{reply.age}</span></div><p>{reply.body}</p></div></div>)}
                    </div>
                  </article>
                ))}
              </section>
            </div>
          </article>
        </main>
        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about"><div class="forum-side-card__banner"></div><div class="forum-about__content"><div class="forum-about__title"><span class={`forum-community-avatar tone-${post.categoryTone}`}>d</span><h2>d/{post.category.toLowerCase().replaceAll(' ', '')}</h2></div><p>Read illustrative conversations about feature details and purchase questions.</p><div class="forum-stats"><span><b>{forumPosts.length}</b> example discussions</span><span><b>{forumPosts.filter((item) => item.category === post.category).length}</b> in this topic</span></div><a class="forum-join" href="/forum/">Browse discussions</a></div></section>
          <section class="forum-side-card forum-related-card" aria-labelledby="forum-related-title">
            <h2 class="forum-side-heading" id="forum-related-title">More discussions</h2>
            <ul class="forum-related-list">
              {relatedPosts.map((item) => (
                <li>
                  <a href={`/forum/${item.slug}/`}>
                    <span class="forum-related-list__category">{item.category}</span>
                    <b>{item.title}</b>
                    <span class="forum-related-list__meta">{item.commentsCount} replies <Icon name="arrowRight" size={14} /></span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="forum-related-card__all" href="/forum/">View all discussions <Icon name="arrowRight" size={14} /></a>
          </section>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

