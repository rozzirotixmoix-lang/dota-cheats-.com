---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import BlogArticleCard from '../../components/BlogArticleCard.astro';
import { blogArticles } from '../../data/blog';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';

const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }];
const [featuredArticle, ...gridArticles] = blogArticles;
const filters = [{ label: 'All articles', icon: 'layers' }, { label: 'Guides', icon: 'navBlog' }, { label: 'Troubleshooting', icon: 'settings' }] as const;
---

<BaseLayout title="Guides – Built-in Commands & Practice | Dota Cheats" description="Guides to private-lobby commands, developer-console settings, and troubleshooting notes for Dota 2 players who want to practice safely." jsonLd={[collectionPageSchema({ name: 'Dota 2 Guides', description: 'Dota 2 practice and console guides.', url: '/blog/' }), breadcrumbSchema(breadcrumbs)]}>
  <section class="min-h-screen bg-[#0d0b14] py-8 md:py-12"><div class="mx-auto max-w-6xl px-5">
    <Breadcrumbs items={breadcrumbs} />
    <div class="mt-6"><BlogArticleCard article={featuredArticle} featured /></div>
    <div class="mt-8 border-t border-white/10"></div>
    <header class="mx-auto mt-8 max-w-4xl text-center"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#b388ff]">Blog</p><h1 class="mt-3 text-3xl font-bold leading-tight text-white md:text-4xl">Guides | Dota 2 commands, private lobby setup and troubleshooting</h1><p class="mt-3 text-sm leading-6 text-[#a7a2b5] md:text-base">Filter by topic to find setup guides, console command lists, and troubleshooting notes.</p><div class="mt-5 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter articles">{filters.map((filter, index) => <button type="button" class:list={['blog-filter inline-flex items-center gap-2 rounded-full border px-3.5 py-2 text-xs font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]', index === 0 ? 'is-active border-[#b388ff]/70 bg-[#b388ff]/15 text-white' : 'border-white/12 bg-[#14101f] text-[#aaa5b6] hover:border-white/25 hover:text-white']} data-blog-filter={filter.label === 'All articles' ? 'all' : filter.label} aria-pressed={index === 0 ? 'true' : 'false'}><Icon name={filter.icon} size={15} />{filter.label}</button>)}</div></header>
    <h2 class="mt-9 text-lg font-bold text-white">Guides: latest articles by topic</h2>
    <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-blog-grid>{gridArticles.map((article) => <BlogArticleCard article={article} />)}</div>
    <section class="mx-auto mt-10 max-w-4xl border-t border-white/10 pt-8 text-sm leading-7 text-[#a7a2b5] md:text-base" aria-labelledby="guide-notes-title">
      <h2 id="guide-notes-title" class="text-lg font-bold text-white">How to use these guides</h2>
      <p class="mt-3">These articles focus on built-in practice tools, private lobbies, and developer-console settings. Start with the article that matches the part of the game you want to test, then follow each step in a private environment before changing additional settings.</p>
      <p class="mt-3">Commands and menus can change with game updates. When a result differs from the guide, check the current in-game console output and official Dota 2 documentation. The guides do not replace the rules of a public match or endorse third-party modifications.</p>
    </section>
  </div></section>
  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-card]')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]')];
    const setFilter = (category: string) => {
      filters.forEach((button) => {
        const active = button.dataset.blogFilter === category;
        button.classList.toggle('is-active', active);
        button.classList.toggle('border-[#b388ff]/70', active);
        button.classList.toggle('bg-[#b388ff]/15', active);
        button.classList.toggle('text-white', active);
        button.setAttribute('aria-pressed', String(active));
      });
      cards.forEach((card) => { if (card.closest('[data-blog-grid]')) card.hidden = category !== 'all' && card.dataset.category !== category; });
    };
    filters.forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.blogFilter ?? 'all')));
    cards.forEach((card) => {
      const open = (event: Event) => { if ((event.target as HTMLElement).closest('a')) return; window.location.assign(card.dataset.link ?? '/blog/'); };
      card.addEventListener('click', open);
      card.addEventListener('keydown', (event) => { if ((event as KeyboardEvent).key === 'Enter' || (event as KeyboardEvent).key === ' ') { event.preventDefault(); open(event); } });
    });
    document.querySelectorAll<HTMLImageElement>('[data-blog-image]').forEach((image) => image.addEventListener('error', () => { image.hidden = true; image.nextElementSibling?.classList.remove('hidden'); image.nextElementSibling?.classList.add('flex'); }));
  </script>
</BaseLayout>
