---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogArticles, getBlogArticle } from '../../data/blog';
import { breadcrumbSchema, articleSchema } from '../../utils/schema';

export const getStaticPaths = (() => blogArticles.map((article) => ({ params: { slug: article.slug } }))) satisfies GetStaticPaths;
const article = getBlogArticle(Astro.params.slug!);
if (!article) return Astro.redirect('/blog/');
const path = `/blog/${article.slug}/`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: article.title, path }];
const isHeading = (block: string) => !block.includes('\n') && block.length < 72 && !block.startsWith('-');
---

<BaseLayout title={article.metaTitle} description={article.metaDescription} jsonLd={[articleSchema({ headline: article.title, description: article.metaDescription, url: path, datePublished: article.publishedAt }), breadcrumbSchema(breadcrumbs)]}>
  <article class="min-h-screen bg-[#0d0b14] py-8 md:py-12"><div class="mx-auto max-w-3xl px-5"><Breadcrumbs items={breadcrumbs} /><header class="mt-8 border-b border-white/10 pb-8"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#b388ff]">{article.category}</p><h1 class="mt-3 text-4xl font-bold leading-tight text-white md:text-5xl">{article.title}</h1><p class="mt-4 text-sm text-[#aaa5b6]">Published {article.publishedAt}</p></header><div class="article-copy mt-8">{article.content.slice(1).map((block) => isHeading(block) ? <h2>{block}</h2> : <p>{block}</p>)}</div></div></article>
</BaseLayout>

<style>.article-copy { color: #c2bdcd; font-size: 1rem; line-height: 1.8; } .article-copy p { margin: 0 0 1.5rem; white-space: pre-line; } .article-copy h2 { margin: 2.5rem 0 1rem; color: #fff; font-size: 1.65rem; font-weight: 700; line-height: 1.25; }</style>
