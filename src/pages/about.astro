---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const pageHeading = 'Resource: Dota 2 Feature Information & Cheats';
const sections = [
  ...content.sections,
  {
    heading: 'Using this resource',
    paragraphs: [
      'Use the comparisons as a starting point for research, not as a promise that a feature, price, game build, or access term is currently available. Product listings and seller documentation can change, so check those sources before making a decision.',
      'The site separates informational pages from external purchase destinations. When you follow an affiliate link, the seller controls checkout, delivery, account access, support, and its own policies. This resource does not handle payments or store purchase credentials.',
      'Editorial pages are written to distinguish built-in practice options from third-party software, and they identify illustrative discussions as examples. Readers should use official documentation and the external seller’s current listing when they need a current technical or commercial answer.',
      'The information is reviewed as a general reference, but it cannot confirm a seller’s present stock, pricing, compatibility, or support response. Before acting on a feature comparison, compare the listed requirements with the current game version and the seller’s own terms.',
      'Clear source labels matter when reading comparisons. Product descriptions, community examples, and external checkout pages serve different purposes, so this site identifies them separately rather than presenting one as proof of another.',
      'If you find an outdated statement, use the purchase destination or official game documentation to verify it before making a decision. Availability, account policies, and feature coverage can change without notice.',
      'Before using a comparison, note the date of the page and the exact question it answers. A description of terminology may help with research, but it cannot replace current product documentation or a seller’s written support terms.',
      'For account and game-safety questions, rely on the game publisher’s official policies. This site does not provide technical support, account recovery, or advice on avoiding enforcement actions.',
      'A useful research note should identify the exact feature or compatibility question being considered. For example, compare a stated system requirement with the device and game version you use, then confirm whether the seller lists any current limitations. This makes a comparison easier to revisit when a game update changes the context.',
      'When reviewing a price, access period, or support promise, save the date and the source you checked. A separate record of those details is more reliable than relying on a summary page, especially when an external listing changes after you have compared several options.',
      'Use the site’s guides and discussion examples to build a short list of questions for official support. Clear questions about compatibility, terms, updates, and refunds help you evaluate information without assuming that an illustrative example applies to every product or account.',
    ],
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: content.title,
      description: content.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <LegalPage
    title={pageHeading}
    description={content.description}
    breadcrumbLabel="About"
    sections={sections}
  />
</BaseLayout>
