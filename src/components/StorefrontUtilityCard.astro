---
import Icon from './icons/Icon.astro';
import ViewDetailsButton from './ViewDetailsButton.astro';
import type { StorefrontProduct } from '../data/productStorefront';

interface Props { product: StorefrontProduct; showImage?: boolean; }
const { product, showImage = true } = Astro.props;
---

<article class="utility-card flex h-full min-h-[25rem] flex-col overflow-hidden rounded-2xl border border-[#b388ff]/25 bg-[#14101f]">
  {showImage && product.image && <a href={product.link} class="utility-card__image relative block h-[7.5rem] shrink-0 overflow-hidden bg-gradient-to-br from-[#211938] to-[#0d0b14] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]"><img src={product.image} alt={product.imageAlt ?? product.title} loading="lazy" class="h-full w-full object-cover object-top" data-product-image /><span class="absolute inset-0 hidden items-center justify-center" data-product-image-fallback aria-hidden="true"><img src="/logo.svg" alt="Dota Cheats logo fallback" class="w-14 opacity-70" /></span></a>}
  <div class="flex flex-1 flex-col p-5">
    <div class="flex size-9 items-center justify-center rounded-xl border border-[#b388ff]/30 bg-[#b388ff]/10 text-[#b388ff]"><Icon name={product.icon} size={18} strokeWidth={1.6} /></div>
    <p class="mt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-[#b388ff]">{product.category}</p>
    <p class="mt-1 text-xl font-bold text-white">{product.title}</p>
    <p class="mt-2 line-clamp-3 text-sm leading-5 text-[#9a96aa]">{product.description}</p>
    <ul class="mt-3 space-y-1.5" aria-label={`${product.title} features`}>
      {product.features.map((feature) => <li class="flex items-center gap-2 text-[13px] leading-5 text-[#b9b5c6]"><Icon name="circleCheck" size={14} class="text-[#b388ff]" strokeWidth={1.8} />{feature}</li>)}
    </ul>
    <div class="mt-auto border-t border-white/10 pt-3">
      <p class="flex items-baseline gap-1.5"><span class="text-xs text-[#8a8699]">From</span><span class="text-xl font-bold text-white">{product.price}</span><span class="text-sm text-[#8a8699]">{product.priceSuffix}</span></p>
      <ViewDetailsButton href={product.link} class="mt-3" ariaLabel={`View ${product.title} details`} />
    </div>
  </div>
</article>

<style>
  .utility-card { transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease; }
  .utility-card:hover, .utility-card:focus-within { border-color: rgba(179, 136, 255, .55); box-shadow: 0 16px 34px rgba(179, 136, 255, .12); transform: translateY(-4px); }
  .utility-card__image img { transition: transform 300ms ease; }
  .utility-card:hover .utility-card__image img { transform: scale(1.03); }
  @media (max-width: 639px) { .utility-card { min-height: 0; } .utility-card__image { height: 7rem; } }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-product-image]').forEach((image) => image.addEventListener('error', () => {
    image.hidden = true;
    image.nextElementSibling?.classList.remove('hidden');
    image.nextElementSibling?.classList.add('flex');
  }));
</script>
