---
import { t } from '../i18n';
import { checkoutPath } from '../config/checkout';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';

const purchaseUrl = checkoutPath('dota2');
const currentPath = Astro.url.pathname;
const navigation: { href: string; label: string; icon: IconName }[] = [
  { href: '/products/dota-2-cheats/', label: 'Products', icon: 'navProducts' },
  { href: '/blog/', label: 'Blog', icon: 'navBlog' },
  { href: '/forum/', label: 'Forum', icon: 'messageCircle' },
  { href: '/faq/', label: 'FAQ', icon: 'navFaq' },
  { href: '/support/', label: 'Support', icon: 'navSupport' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4" data-site-header>
  <div class="nav-shell mx-auto flex h-14 w-full max-w-7xl items-center gap-4 rounded-2xl px-4 sm:h-[3.75rem] sm:px-5 xl:grid xl:grid-cols-[1fr_auto_1fr] xl:gap-6">
    <a href="/" class="inline-flex min-w-0 shrink-0 items-center font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0b14] xl:justify-self-start" aria-label={t.ui.homeAria}>
      <span class="truncate" aria-hidden="true">Dota<span class="text-[#b388ff]"> Cheats</span></span>
    </a>

    <nav class="ml-auto hidden items-center gap-7 xl:ml-0 xl:flex xl:justify-self-center" aria-label="Primary">
      {navigation.map((link) => (
        <a href={link.href} class:list={['inline-flex items-center gap-2 text-[13px] font-medium uppercase tracking-[0.08em] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0b14]', isActive(link.href) ? 'font-bold text-white' : 'text-[#6b6880] hover:text-[#e9e6f2]']} aria-current={isActive(link.href) ? 'page' : undefined}>
          <Icon name={link.icon} size={16} strokeWidth={1.6} />
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-3 xl:ml-0 xl:justify-self-end">
      <a href={purchaseUrl} class="try-now-btn hidden h-10 items-center overflow-hidden rounded-xl bg-[#f7f6fb] text-[13px] font-bold text-[#161220] transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#b388ff]/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0b14] sm:inline-flex" aria-label={t.ui.checkoutAria}>
        <span class="px-3.5">Try Now</span><span class="flex h-full w-10 items-center justify-center border-l border-black/10 bg-[#e9e7ef]" aria-hidden="true"><Icon name="arrowRight" size={17} strokeWidth={1.8} /></span>
      </a>

      <span class="hidden h-7 w-px bg-white/10 xl:block" aria-hidden="true"></span>
      <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="nav-theme-toggle" />

      <Sheet class="xl:hidden">
        <SheetTrigger class="inline-flex size-10 items-center justify-center rounded-xl border border-white/15 bg-[#100d19] text-white transition-colors hover:border-white/25 hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]" aria-label={t.ui.menuOpen}>
          <Icon name="menu" size={20} strokeWidth={1.6} />
        </SheetTrigger>
        <SheetContent side="right" class="nav-mobile-panel flex w-[min(100vw-1.5rem,22rem)] flex-col gap-5 border-white/10 bg-[#14101f] text-white">
          <SheetHeader><SheetTitle class="text-white">{t.site.name}</SheetTitle></SheetHeader>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {navigation.map((link) => (
              <a href={link.href} class:list={['flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold uppercase tracking-[0.08em] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]', isActive(link.href) ? 'bg-white/8 text-white' : 'text-[#a19eaf] hover:bg-white/5 hover:text-white']} aria-current={isActive(link.href) ? 'page' : undefined}>
                <Icon name={link.icon} size={17} strokeWidth={1.6} />{link.label}
              </a>
            ))}
          </nav>
          <div class="mt-auto grid gap-3 border-t border-white/10 pt-5">
            <a href={purchaseUrl} class="try-now-btn inline-flex h-11 items-center justify-between overflow-hidden rounded-xl bg-[#f7f6fb] text-sm font-bold text-[#161220] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]"><span class="px-4">Try Now</span><span class="flex h-full w-11 items-center justify-center border-l border-black/10 bg-[#e9e7ef]" aria-hidden="true"><Icon name="arrowRight" size={18} strokeWidth={1.8} /></span></a>
          </div>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>

<style>
  .nav-shell { background: linear-gradient(110deg, #0d0b14 0%, #14101f 100%); border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035), 0 12px 30px rgba(0, 0, 0, 0.18); transition: background 150ms ease, box-shadow 150ms ease; }
  .is-scrolled .nav-shell { background: rgba(13, 11, 20, .76); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 12px 30px rgba(0, 0, 0, 0.26); backdrop-filter: blur(18px); }
</style>

<script>
  const syncHeaderScrollState = () => {
    document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    });
  };

  syncHeaderScrollState();
  window.addEventListener('scroll', syncHeaderScrollState, { passive: true });
  document.addEventListener('astro:after-swap', syncHeaderScrollState);
</script>
