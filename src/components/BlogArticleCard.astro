---
import Icon from './icons/Icon.astro';
import type { BlogArticle } from '../data/blog';

interface Props { article: BlogArticle; featured?: boolean; }
const { article, featured = false } = Astro.props;
const categoryLabel = article.category === 'Guides' ? 'Practice' : article.category;
---

<article class:list={['blog-article-card overflow-hidden rounded-2xl border border-[#b388ff]/25 bg-[#14101f]', featured ? 'md:grid md:grid-cols-2' : 'flex h-full flex-col']} data-blog-card data-category={article.category} data-link={article.link} tabindex="0">
  <div class:list={['relative aspect-video overflow-hidden bg-gradient-to-br from-[#211938] to-[#0d0b14]', featured && 'md:h-full md:aspect-auto']}>
    <img src={article.image} alt={article.imageAlt} loading={featured ? 'eager' : 'lazy'} class="h-full w-full object-cover" data-blog-image />
    <div class="absolute inset-0 hidden items-center justify-center" data-image-fallback aria-hidden="true"><img src="/logo.svg" alt="Dota Cheats logo fallback" class="w-16 opacity-70" /></div>
    <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-lg bg-[#100d19]/90 px-2.5 py-1.5 text-[11px] font-bold text-white"><Icon name="navBlog" size={14} /> {categoryLabel}</span>
    <time class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-lg bg-[#100d19]/90 px-2.5 py-1.5 text-[11px] font-bold text-white"><Icon name="calendar" size={14} /> {article.date}</time>
  </div>
  <div class:list={['flex flex-col p-5', featured && 'md:p-8']}>
    <h2 class:list={[featured ? 'text-3xl md:text-4xl' : 'line-clamp-2 text-xl', 'font-bold leading-tight text-white']}><a href={article.link} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]">{article.title}</a></h2>
    <p class:list={[featured ? 'mt-4' : 'mt-3 line-clamp-2', 'text-sm leading-6 text-[#a7a2b5]']}>{article.excerpt}</p>
    <div class:list={['flex items-center justify-between gap-3 border-t border-white/10 pt-4', featured ? 'mt-8' : 'mt-auto mt-5']}>
      <span class="inline-flex items-center gap-1.5 text-xs text-[#9691a4]"><Icon name="clock" size={15} /> {article.readMinutes} min read</span>
      <a href={article.link} class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 px-3 py-2 text-xs font-bold text-white transition-colors hover:border-[#b388ff]/60 hover:bg-[#b388ff]/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b388ff]">Read<span class="sr-only">: {article.title}</span> <Icon name="arrowRight" size={15} /></a>
    </div>
  </div>
</article>

<style>
  .blog-article-card { cursor: pointer; transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease; }
  .blog-article-card:hover, .blog-article-card:focus-within { transform: translateY(-4px); border-color: rgba(179, 136, 255, .55); box-shadow: 0 16px 34px rgba(179, 136, 255, .14); }
</style>
