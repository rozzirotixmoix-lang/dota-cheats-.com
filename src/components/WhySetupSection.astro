---
import {t} from '../i18n';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
---
<section class="py-16 md:py-24"><div class="mx-auto max-w-6xl px-5">
<SectionHeader eyebrow={t.whyUs.eyebrow} title={t.whyUs.title} desc={t.whyUs.subtitle}/>
<div class="mt-10 grid gap-5 md:grid-cols-3">{t.whyUs.rows.map((r,i)=><article class="rounded-2xl border border-border bg-card p-6"><span class="inline-flex rounded-xl bg-primary/15 p-3"><Icon name={(['users','eye','clock'] as const)[i]}/></span><p class="mt-5 text-xl font-bold">{r.title}</p><p class="mt-3 text-sm leading-relaxed text-muted-foreground">{r.desc}</p></article>)}</div>
</div></section>
