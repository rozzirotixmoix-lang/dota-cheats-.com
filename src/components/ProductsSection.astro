---
import { utilityStorefrontProducts } from '../data/productStorefront';
import SectionHeader from './SectionHeader.astro';
import StorefrontUtilityCard from './StorefrontUtilityCard.astro';
---

<section id="products" class="products-section py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Products"
      title="Choose your Dota 2 utility"
      desc="Compare the available product categories before opening the product page."
      titleId="products-title"
    />

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {utilityStorefrontProducts.map((product) => <StorefrontUtilityCard product={product} showImage={false} />)}
    </div>
  </div>
</section>

<style>
  .products-section { background: #0d0b14; }
</style>
