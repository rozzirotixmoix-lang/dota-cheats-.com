---
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import SiteFaqSection from './SiteFaqSection.astro';
import ReviewPreview from './ReviewPreview.astro';
import { getLandingFaqs } from '../data/faq';
import { forumPosts } from '../data/forum';
import { Button } from '@/components/starwind/button';
---
<WorkflowSection />
<section class="border-y border-border bg-muted/20 py-16 md:py-24">
 <div class="mx-auto max-w-6xl px-5">
  <SectionHeader eyebrow="Forums" title="A few questions before you choose" desc="Illustrative conversations about feature details, compatibility and purchasing." />
  <div class="mt-10 grid gap-5 md:grid-cols-3">
   {forumPosts.slice(0,3).map(p=><article class="rounded-2xl border border-border bg-card p-6"><p class="text-xs text-primary">{p.category} · Example discussion</p><p class="mt-3 text-xl font-bold"><a href={'/forum/'+p.slug+'/'} class="hover:text-primary">{p.title}</a></p><p class="mt-3 text-sm text-muted-foreground">{p.excerpt}</p><p class="mt-5 text-xs text-muted-foreground">{p.commentsCount} illustrative replies</p></article>)}
  </div>
  <div class="mt-8 text-center"><Button as="a" href="/forum/" variant="outline">Browse all discussions</Button></div>
 </div>
</section>
<ReviewPreview />
<SiteFaqSection id="faq" titleId="faq-title" items={getLandingFaqs()} />
